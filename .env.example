# ==============================================================================
# CONQUIZ V9.0 – CONFIGURAȚIE PRODUCȚIE & DEVELOPMENT (.env.example)
# ==============================================================================

# Mediu de rulare ('development' sau 'production')
NODE_ENV=production
PORT=3000
APP_URL=https://conquiz.domeniu.ro

# Securitate JWT & Cont Admin Inițial
JWT_SECRET=schimba_acest_secret_intr_un_string_aleator_de_minim_64_caractere
ADMIN_EMAIL=admin@conquiz.ro
ADMIN_USERNAME=MareleVoievod
ADMIN_PASSWORD=SchimbaParolaAdmin123!

# Persistență PostgreSQL (Dacă DATABASE_URL este setat, PostgreSQL devine activ;
# în caz contrar, aplicația folosește fallback-ul JSON din data/conquiz_db.json)
POSTGRES_DB=conquiz
POSTGRES_USER=conquiz_user
POSTGRES_PASSWORD=SchimbaParolaPostgres123!
DATABASE_URL=postgresql://conquiz_user:SchimbaParolaPostgres123!@db:5432/conquiz

# Cloudflare Tunnel Token (Zero-Trust outbound tunnel fără port forwarding)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...token_cloudflare_tunnel_aici

# Opțional: Cheie Gemini API pentru generare asistată de întrebări în panoul Admin
GEMINI_API_KEY=
