# ==============================================================================
# CONQUIZ V9.2 – FIȘIER EXEMPLU DE CONFIGURARE (.env.example)
# ==============================================================================
# IMPORTANT: Acest fișier conține DOAR valori marcate ca neconfigurate.
# Aplicația REFUZĂ pornirea în producție (NODE_ENV=production) dacă aceste
# valori nu sunt înlocuite cu secrete reale generate aleator.
# Pentru a genera un secret sigur în Linux: openssl rand -hex 32
#
# Notă pentru dezvoltare / Google AI Studio Preview:
# În modul development sau când DATABASE_URL lipsește, aplicația pornește automat
# folosind fallback-ul JSON local (fără a necesita PostgreSQL activ).
# ==============================================================================

NODE_ENV=production
PORT=3000

# URL-ul public HTTPS al subdomeniului configurat în Porkbun DNS + Nginx Proxy Manager
# Linkurile de resetare a parolei sunt construite EXCLUSIV din APP_URL (niciodată din header-ul Host)
APP_URL=https://conquiz.exemplu-domeniu.ro

# Secret criptografic pentru semnarea tokenurilor JWT (minim 32 caractere aleatorii)
JWT_SECRET=INLOCUIESTE_CU_SECRET_JWT_ALEATOR_MINIM_32_CARACTERE

# Credențiale pentru contul inițial de administrator (parolă de minim 16 caractere)
ADMIN_EMAIL=admin@exemplu-domeniu.ro
ADMIN_USERNAME=MareleVoievod
ADMIN_PASSWORD=INLOCUIESTE_CU_PAROLA_ADMIN_SIGURA_MIN_16_CARACTERE

# Configurație PostgreSQL 16 (serviciul `db` din docker-compose.yml pe rețeaua internă `conquiz_internal`)
POSTGRES_DB=conquiz
POSTGRES_USER=conquiz_user
POSTGRES_PASSWORD=INLOCUIESTE_CU_PAROLA_POSTGRES_SIGURA_MIN_16_CARACTERE
DATABASE_URL=postgresql://conquiz_user:INLOCUIESTE_CU_PAROLA_POSTGRES_SIGURA_MIN_16_CARACTERE@db:5432/conquiz

# Configurație SMTP externă pentru Resetarea Parolei prin Email ("Am uitat parola")
# Notă: Înregistrarea unui domeniu la Porkbun NU oferă automat serviciu de email SMTP.
# Folosește un furnizor SMTP dedicat (ex. Brevo, Resend, Mailgun, Amazon SES, Proton/Fastmail sau Porkbun Email plătit).
SMTP_HOST=smtp.furnizor-email.exemplu.ro
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=utilizator_smtp_exemplu
SMTP_PASS=INLOCUIESTE_CU_PAROLA_SAU_CHEIA_SMTP
SMTP_FROM="CONQUIZ România <no-reply@exemplu-domeniu.ro>"
PASSWORD_RESET_EXPIRY_MINUTES=30

# Interval salvare neblocantă snapshot camere active în PostgreSQL (ms)
ACTIVE_ROOM_SNAPSHOT_INTERVAL_MS=15000

# Mod de mentenanță planificată (blochează temporar meciurile noi și afișează ecranul de mentenanță în română)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Aplicația este momentan în mentenanță sau oprită temporar. Vă rugăm să reveniți în curând."

# Opțional: Cheie Gemini API pentru generare asistată în panoul Admin
GEMINI_API_KEY=

